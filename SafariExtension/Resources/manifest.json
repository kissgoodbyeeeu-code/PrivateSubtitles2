{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "version": "0.2.0",
  "icons": {
    "128": "images/icon-128.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "nativeMessaging"
  ]
}
